# Copy to .env and adjust. Defaults match ../docker-compose.yml (run: npm run db:up).

NODE_ENV=development
PORT=3000

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=prueba
DB_PASSWORD=prueba
DB_DATABASE=tablero

